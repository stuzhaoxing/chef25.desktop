{
  "name": "chef25-desktop",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/check-runtime.mjs && tauri build",
    "runtime:prepare": "node --use-env-proxy scripts/prepare-runtime.mjs",
    "runtime:check": "node scripts/check-runtime.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check && npm run privacy:check",
    "privacy:check": "node scripts/check-public-source.mjs",
    "downloads:build": "node scripts/build-download-pages.mjs",
    "downloads:deploy": "npm run downloads:build && cd deploy && wrangler pages deploy --project-name chef25-downloads --branch main"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "lucide-react": "^0.577.0",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.5",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
