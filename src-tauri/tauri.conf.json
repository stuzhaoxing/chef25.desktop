{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "25小厨",
  "version": "0.3.0",
  "identifier": "com.chef25.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:25251",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "25小厨",
        "width": 860,
        "height": 640,
        "minWidth": 720,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost https://www.chef25.com/api/tavern-guide; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/runtime/": "runtime/"
    },
    "category": "Entertainment",
    "shortDescription": "Your SillyTavern desktop companion",
    "copyright": "Copyright Chef25 contributors",
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBERkI3RjIyRkU2QTRBOUEKUldTYVNtcitJbi83RFFnTzVidnZtc1NtbVRwV0NXZmh5QWVmTkphaDBlRjU4aTN6YmptNXZPMFQK",
      "endpoints": ["https://www.chef25.com/downloads/updater.json"],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
